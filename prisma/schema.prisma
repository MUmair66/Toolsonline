generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

// MySQL on Hostinger — same server as the website, so queries take ~1 ms and the database never sleeps.
// Text searches are case-insensitive through the table collation (utf8mb4 *_ci), so no `mode` option is needed.
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id          String    @id @default(cuid())
  name        String
  email       String    @unique
  password    String
  role        String    @default("CUSTOMER") // CUSTOMER | STAFF | ADMIN
  permissions String    @default("[]") @db.VarChar(1000) // JSON array of section keys, used for STAFF
  active      Boolean   @default(true)
  lastLoginAt DateTime?
  phone       String?
  address     String?   @db.Text
  city        String?
  postalCode  String?
  country     String?
  createdAt   DateTime  @default(now())
  orders      Order[]
  reviews     Review[]
  addresses   Address[]
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?   @db.Text
  image       String?   @db.VarChar(1000)
  createdAt   DateTime  @default(now())
  products    Product[]
}

model Product {
  id           String      @id @default(cuid())
  name         String      @db.VarChar(500)
  slug         String      @unique @db.VarChar(500)
  description  String      @db.Text
  price        Float
  comparePrice Float?
  stock        Int         @default(0)
  sku          String?
  images       String      @default("[]") @db.VarChar(8000) // JSON array of URLs
  featured     Boolean     @default(false)
  active       Boolean     @default(true)
  categoryId   String?
  category     Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brandId      String?
  brand        Brand?      @relation(fields: [brandId], references: [id], onDelete: SetNull)
  reviews      Review[]
  orderItems   OrderItem[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([active, featured])
  @@index([categoryId])
  @@index([brandId])
  @@index([createdAt])
  @@index([price])
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String   @db.Text
  approved  Boolean  @default(true)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([productId, approved])
  @@index([userId])
}

model Order {
  id            String      @id @default(cuid())
  orderNumber   String      @unique
  userId        String?
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  name          String
  email         String
  phone         String
  address       String      @db.Text
  city          String
  postalCode    String
  country       String
  subtotal      Float
  discount      Float       @default(0)
  shipping      Float       @default(0)
  tax           Float       @default(0)
  total         Float
  couponCode    String?
  paymentMethod String      @default("COD") // COD | CARD
  paymentStatus String      @default("PENDING") // PENDING | PAID | REFUNDED
  status        String      @default("PENDING") // PENDING | PROCESSING | SHIPPED | DELIVERED | CANCELLED
  notes         String?     @db.Text
  items         OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([userId])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name      String   @db.VarChar(500)
  image     String?  @db.VarChar(1000)
  price     Float
  quantity  Int

  @@index([orderId])
  @@index([productId])
}

model Coupon {
  id        String    @id @default(cuid())
  code      String    @unique
  type      String    @default("PERCENT") // PERCENT | FIXED
  value     Float
  minOrder  Float     @default(0)
  maxUses   Int?
  usedCount Int       @default(0)
  expiresAt DateTime?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
}

model Message {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String   @db.VarChar(500)
  message   String   @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Setting {
  id                    Int     @id @default(1)
  storeName             String  @default("ShopNext")
  tagline               String  @default("Quality products, delivered fast.") @db.VarChar(500)
  contactEmail          String  @default("support@shopnext.com")
  contactPhone          String  @default("+1 (555) 123-4567")
  currency              String  @default("USD")
  shippingFee           Float   @default(5)
  freeShippingThreshold Float   @default(100)
  taxRate               Float   @default(0)
  announcement          String? @default("Free shipping on orders over $100!") @db.VarChar(1000)
  lowStockThreshold     Int     @default(5)
  autoHideOutOfStock    Boolean @default(false)
  autoPaidOnDelivery    Boolean @default(true)
  restockOnCancel       Boolean @default(true)
  reviewModeration      Boolean @default(false)
  staleOrderDays        Int     @default(7)
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  userName  String
  action    String // created | updated | deleted | bulk | login | import | automation ...
  entity    String // product | order | customer | ...
  entityId  String?
  details   String?  @db.Text
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String   @default("Home") // Home | Work | Other
  name       String
  phone      String
  address    String   @db.Text
  city       String
  postalCode String
  country    String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([userId])
}

model Brand {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?   @db.Text
  logo        String?   @db.VarChar(1000)
  createdAt   DateTime  @default(now())
  products    Product[]
}
