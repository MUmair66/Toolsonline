generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("CUSTOMER") // CUSTOMER | STAFF | ADMIN
  permissions String   @default("[]") // JSON array of section keys, used for STAFF
  active    Boolean  @default(true)
  lastLoginAt DateTime?
  phone     String?
  address   String?
  city      String?
  postalCode String?
  country   String?
  createdAt DateTime @default(now())
  orders    Order[]
  reviews   Review[]
  addresses Address[]
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  image       String?
  createdAt   DateTime  @default(now())
  products    Product[]
}

model Product {
  id           String      @id @default(cuid())
  name         String
  slug         String      @unique
  description  String
  price        Float
  comparePrice Float?
  stock        Int         @default(0)
  sku          String?
  images       String      @default("[]") // JSON array of URLs
  featured     Boolean     @default(false)
  active       Boolean     @default(true)
  categoryId   String?
  category     Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  reviews      Review[]
  orderItems   OrderItem[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([active, featured])
  @@index([categoryId])
  @@index([createdAt])
  @@index([price])
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String
  approved  Boolean  @default(true)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([productId, approved])
  @@index([userId])
}

model Order {
  id            String      @id @default(cuid())
  orderNumber   String      @unique
  userId        String?
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  name          String
  email         String
  phone         String
  address       String
  city          String
  postalCode    String
  country       String
  subtotal      Float
  discount      Float       @default(0)
  shipping      Float       @default(0)
  tax           Float       @default(0)
  total         Float
  couponCode    String?
  paymentMethod String      @default("COD") // COD | CARD
  paymentStatus String      @default("PENDING") // PENDING | PAID | REFUNDED
  status        String      @default("PENDING") // PENDING | PROCESSING | SHIPPED | DELIVERED | CANCELLED
  notes         String?
  items         OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([userId])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name      String
  image     String?
  price     Float
  quantity  Int

  @@index([orderId])
  @@index([productId])
}

model Coupon {
  id        String    @id @default(cuid())
  code      String    @unique
  type      String    @default("PERCENT") // PERCENT | FIXED
  value     Float
  minOrder  Float     @default(0)
  maxUses   Int?
  usedCount Int       @default(0)
  expiresAt DateTime?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
}

model Message {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Setting {
  id                    Int     @id @default(1)
  storeName             String  @default("ShopNext")
  tagline               String  @default("Quality products, delivered fast.")
  contactEmail          String  @default("support@shopnext.com")
  contactPhone          String  @default("+1 (555) 123-4567")
  currency              String  @default("USD")
  shippingFee           Float   @default(5)
  freeShippingThreshold Float   @default(100)
  taxRate               Float   @default(0)
  announcement          String? @default("Free shipping on orders over $100!")
  lowStockThreshold     Int     @default(5)
  autoHideOutOfStock    Boolean @default(false)
  autoPaidOnDelivery    Boolean @default(true)
  restockOnCancel       Boolean @default(true)
  reviewModeration      Boolean @default(false)
  staleOrderDays        Int     @default(7)
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  userName  String
  action    String // created | updated | deleted | bulk | login | import | automation ...
  entity    String // product | order | customer | ...
  entityId  String?
  details   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String   @default("Home") // Home | Work | Other
  name       String
  phone      String
  address    String
  city       String
  postalCode String
  country    String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([userId])
}
