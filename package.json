{
  "name": "shopnext",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build",
    "start": "next start",
    "setup": "prisma db push && tsx --env-file=.env prisma/catalog.ts --reset",
    "db:reset": "prisma db push --force-reset && tsx --env-file=.env prisma/catalog.ts --reset",
    "postinstall": "prisma generate",
    "catalog:sync": "tsx --env-file=.env prisma/catalog.ts",
    "catalog:reset": "tsx --env-file=.env prisma/catalog.ts --reset"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1154.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.12",
    "lucide-react": "^1.59.0",
    "next": "^15.5.28",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true
  }
}
